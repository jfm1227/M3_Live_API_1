{
  "name": "Python GCP Project",
  "image": "mcr.microsoft.com/devcontainers/python:3.11", // Pythonイメージを指定
  "features": {
    "ghcr.io/devcontainers/features/google-cloud-cli:0": {} // これを追加！
  },
  "containerEnv": {
    "GOOGLE_APPLICATION_CREDENTIALS": "/tmp/gcp-key.json"
  },
  "remoteEnv": {
    "GCP_SA_KEY": "${localEnv:GCP_SA_KEY}"
  },
  "postCreateCommand": "bash .devcontainer/postCreateCommand.sh"
}